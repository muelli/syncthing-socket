<?xml version="1.0" encoding="utf-8"?>
<!--
  Only views RemoteViews supports: no Compose out here, and no custom views.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Tapping the status row re-checks, so a glance never starts an unlock. -->
    <LinearLayout
        android:id="@+id/widget_status_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/widget_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/dot_unknown"
            android:contentDescription="@string/widget_status_description" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#FFCCCCCC"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/entry_checking" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_unlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/unlock_button"
        android:textColor="#FF21005D"
        android:background="@drawable/widget_button_background" />
</LinearLayout>
