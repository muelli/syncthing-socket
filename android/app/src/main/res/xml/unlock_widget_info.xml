<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is 30 minutes because that is the floor Android enforces; anything
  smaller is silently rounded up. The status is therefore refreshed on tap rather than
  relying on this.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_unlock"
    android:minWidth="180dp"
    android:minHeight="80dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
