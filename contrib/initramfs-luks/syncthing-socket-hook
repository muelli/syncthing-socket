#!/bin/sh
# initramfs-tools hook: put syncthing-socket and the CA bundle into the initramfs.
# INSTALLATION: /etc/initramfs-tools/hooks/syncthing-socket, mode 0755.

PREREQ="cryptroot"
prereqs() { echo "$PREREQ"; }
case $1 in
prereqs)
	prereqs
	exit 0
	;;
esac

. /usr/share/initramfs-tools/hook-functions

# Packaged installs land in /usr/bin, manual ones usually in /usr/local/bin. Override with
# SYNCTHING_SOCKET_BIN if yours is somewhere else.
# The same search the dracut module does, in the same order. Trying PATH first covers an
# unusual prefix, and the explicit list covers the case PATH cannot: an initramfs is
# normally rebuilt from a maintainer script or a kernel hook, and those run with a PATH
# that excludes /usr/local/bin.
#
# /usr/sbin is in the list because it is where an install that wants to be findable from a
# maintainer script puts the binary. It was missing here while the dracut module had it,
# so the same binary in the same place worked on one initramfs generator and was skipped
# by the other.
if [ -z "${SYNCTHING_SOCKET_BIN:-}" ]; then
	SYNCTHING_SOCKET_BIN=$(command -v syncthing-socket 2> /dev/null || true)
fi
if [ -z "${SYNCTHING_SOCKET_BIN:-}" ]; then
	for candidate in /usr/local/sbin/syncthing-socket /usr/local/bin/syncthing-socket \
		/usr/sbin/syncthing-socket /usr/bin/syncthing-socket; do
		if [ -x "$candidate" ]; then
			SYNCTHING_SOCKET_BIN="$candidate"
			break
		fi
	done
fi

if [ -z "${SYNCTHING_SOCKET_BIN:-}" ] || [ ! -x "$SYNCTHING_SOCKET_BIN" ]; then
	# Loud, because the consequence is silent: the local-top script is installed
	# separately and still runs, finds no binary, and exits 0. The machine then sits at
	# its passphrase prompt at the next boot with nothing saying why.
	echo "W: syncthing-socket: no binary found on PATH, /usr/local/sbin, /usr/local/bin," >&2
	echo "W: syncthing-socket: /usr/sbin or /usr/bin. Set SYNCTHING_SOCKET_BIN to point at it." >&2
	echo "W: syncthing-socket: remote LUKS unlock will NOT be available from this initramfs." >&2
	exit 0
fi

# copy_exec resolves usrmerge, so this lands at /usr/bin and /bin/syncthing-socket
# resolves to it inside the initramfs.
copy_exec "$SYNCTHING_SOCKET_BIN" /bin/

# The unlock configuration, when it is not stored in the LUKS2 header. Mode 0600 in the
# initramfs is cosmetic, since an unencrypted /boot is readable by anyone with the disk,
# but it keeps the seed out of casual view on the running system.
if [ -r /etc/syncthing-socket/luks.conf ]; then
	mkdir -p "$DESTDIR/etc/syncthing-socket"
	cp -a /etc/syncthing-socket/luks.conf "$DESTDIR/etc/syncthing-socket/luks.conf"
	chmod 0600 "$DESTDIR/etc/syncthing-socket/luks.conf"
fi

# Syncthing's discovery and relay pools are reached over HTTPS, so the initramfs needs a
# trust store. Without it every lookup fails with a certificate error and the unlock
# silently retries forever.
if [ -r /etc/ssl/certs/ca-certificates.crt ]; then
	mkdir -p "$DESTDIR/etc/ssl/certs"
	cp -a /etc/ssl/certs/ca-certificates.crt "$DESTDIR/etc/ssl/certs/"
else
	echo "W: syncthing-socket: /etc/ssl/certs/ca-certificates.crt missing;" >&2
	echo "W: install the ca-certificates package or discovery will fail." >&2
fi
