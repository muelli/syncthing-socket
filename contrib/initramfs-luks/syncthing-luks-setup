#!/bin/bash
# Enrol a phone as the key holder for a LUKS volume and print the pairing QR code.
#
# Topology: the phone dials out. This machine announces from its initramfs and waits; the
# phone connects and pushes the passphrase when you tap unlock. That suits Android, which
# cannot reliably hold a listening service open in the background while a machine boots.
#
# Both identities come from one seed: this machine uses seed + "server", the phone uses
# seed + "client".

set -eu

if ! command -v qrencode > /dev/null 2>&1; then
    echo "Error: qrencode is required. Please install it (e.g. apt install qrencode)." >&2
    exit 1
fi
if ! command -v syncthing-socket > /dev/null 2>&1; then
    echo "Error: syncthing-socket is not on PATH." >&2
    exit 1
fi

DEVICE=${1:-}
if [ -z "$DEVICE" ]; then
    echo "Usage: syncthing-luks-setup <luks-device>" >&2
    exit 1
fi

if ! cryptsetup isLuks --type luks2 "$DEVICE"; then
    echo "Error: $DEVICE is not a LUKS2 device." >&2
    exit 1
fi

printf 'Enter the LUKS passphrase for %s (will be hidden): ' "$DEVICE"
read -rs PASSPHRASE
echo ""
if [ -z "$PASSPHRASE" ]; then
    echo "Error: empty passphrase." >&2
    exit 1
fi

# Check it actually opens the device before writing it into a QR code. Without this a
# typo is enrolled silently and only surfaces at the next boot, as
# "No key available with this passphrase" from an initramfs, which is a poor place to
# discover it and gives no hint that the QR code is the thing at fault.
if ! printf %s "$PASSPHRASE" | cryptsetup open --test-passphrase --key-file=- "$DEVICE"; then
    echo "" >&2
    echo "Error: that passphrase does not unlock $DEVICE." >&2
    echo "Nothing has been changed. Enrolling it would produce a QR code that cannot" >&2
    echo "unlock this machine, and the failure would only appear at the next boot." >&2
    exit 1
fi
echo "Passphrase verified against $DEVICE."

UNLOCK_SEED=$(head -c 32 /dev/urandom | base64)

IDS=$(syncthing-socket id --passphrase "$UNLOCK_SEED")
MACHINE_DEVICE_ID=$(echo "$IDS" | awk '/^Server ID:/ {print $3}')
PHONE_DEVICE_ID=$(echo "$IDS" | awk '/^Client ID:/ {print $3}')
if [ -z "$MACHINE_DEVICE_ID" ] || [ -z "$PHONE_DEVICE_ID" ]; then
    echo "Error: could not derive Device IDs from the seed." >&2
    exit 1
fi

# The JSON keys are what the Android app parses. "phone_seed" is the seed the phone derives
# its client identity from, and "laptop_device_id" is the Device ID it connects to, i.e.
# this machine's Server ID.
TMPJSON=$(mktemp)
trap 'rm -f "$TMPJSON"' EXIT
chmod 600 "$TMPJSON"
cat > "$TMPJSON" <<EOF
{"passphrase":"$PASSPHRASE","phone_seed":"$UNLOCK_SEED","laptop_device_id":"$MACHINE_DEVICE_ID"}
EOF

echo ""
echo "================================================================="
echo "Scan this QR code with the Syncthing LUKS Unlocker Android App:"
echo "================================================================="
qrencode -t ANSIUTF8 < "$TMPJSON"
echo "================================================================="
echo ""
echo "This machine's Device ID: $MACHINE_DEVICE_ID"
echo "Phone's Device ID:        $PHONE_DEVICE_ID"
echo ""
echo "The QR code contains your LUKS passphrase. Do not photograph or share it."
echo ""
echo "Now bind the configuration into the LUKS2 header:"
echo ""
echo "  syncthing-luks-bind $DEVICE \"$UNLOCK_SEED\" \"$PHONE_DEVICE_ID\" server"
echo ""
echo "Then rebuild the initramfs:  update-initramfs -u -k all"
